{
  "info": {
    "name": "Viral Flight — Flutter API Contract",
    "description": "Quote requests, connections, discovery, brand/agency details, uploads, notifications, agency dashboard",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "https://viralflight.cloud" },
    { "key": "accessToken", "value": "YOUR_JWT_ACCESS_TOKEN" },
    { "key": "influencerProfileId", "value": "INFLUENCER_PROFILE_ID" },
    { "key": "brandProfileId", "value": "BRAND_PROFILE_ID" },
    { "key": "agencyProfileId", "value": "AGENCY_PROFILE_ID" },
    { "key": "quoteRequestId", "value": "QUOTE_REQUEST_ID" },
    { "key": "notificationId", "value": "NOTIFICATION_ID" }
  ],
  "item": [
    {
      "name": "Quote Requests",
      "item": [
        {
          "name": "Create Quote Request",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"influencerProfileId\": \"{{influencerProfileId}}\",\n  \"message\": \"Need 2 Reels for Diwali\",\n  \"deliverables\": [\"reel\", \"story\"],\n  \"budgetHint\": 25000,\n  \"currency\": \"INR\"\n}"
            },
            "url": "{{baseUrl}}/api/quote-requests"
          }
        },
        {
          "name": "List Quote Requests",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": "{{baseUrl}}/api/quote-requests"
          }
        },
        {
          "name": "Respond (Influencer)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"quotedAmount\": 30000,\n  \"currency\": \"INR\",\n  \"note\": \"Includes edits\",\n  \"validityDays\": 14\n}"
            },
            "url": "{{baseUrl}}/api/quote-requests/{{quoteRequestId}}/respond"
          }
        },
        {
          "name": "Accept",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": "{{baseUrl}}/api/quote-requests/{{quoteRequestId}}/accept"
          }
        },
        {
          "name": "Decline",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": "{{baseUrl}}/api/quote-requests/{{quoteRequestId}}/decline"
          }
        },
        {
          "name": "Withdraw",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": "{{baseUrl}}/api/quote-requests/{{quoteRequestId}}/withdraw"
          }
        }
      ]
    },
    {
      "name": "Connections",
      "item": [
        {
          "name": "Connect",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"influencerProfileId\": \"{{influencerProfileId}}\",\n  \"note\": \"Interested in collab\"\n}"
            },
            "url": "{{baseUrl}}/api/connections"
          }
        },
        {
          "name": "List Connections",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": "{{baseUrl}}/api/connections"
          }
        },
        {
          "name": "Connection Status",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": "{{baseUrl}}/api/connections/{{influencerProfileId}}/status"
          }
        },
        {
          "name": "Disconnect",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": "{{baseUrl}}/api/connections/{{influencerProfileId}}"
          }
        }
      ]
    },
    {
      "name": "Discovery",
      "item": [
        {
          "name": "List Influencers",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": "{{baseUrl}}/api/influencers?limit=30"
          }
        },
        {
          "name": "List Brands",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": "{{baseUrl}}/api/brands?limit=30"
          }
        },
        {
          "name": "List Agencies",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": "{{baseUrl}}/api/agencies?limit=30"
          }
        }
      ]
    },
    {
      "name": "Brand Details",
      "item": [
        {
          "name": "Get Brand Profile",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": "{{baseUrl}}/api/brands/{{brandProfileId}}"
          }
        },
        {
          "name": "Get Brand Campaigns",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": "{{baseUrl}}/api/brands/{{brandProfileId}}/campaigns"
          }
        }
      ]
    },
    {
      "name": "Agency Details",
      "item": [
        {
          "name": "Get Agency Profile",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": "{{baseUrl}}/api/agencies/{{agencyProfileId}}"
          }
        },
        {
          "name": "Get Agency Campaigns",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": "{{baseUrl}}/api/agencies/{{agencyProfileId}}/campaigns"
          }
        },
        {
          "name": "Agency Dashboard KPIs",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": "{{baseUrl}}/api/agency/dashboard"
          }
        }
      ]
    },
    {
      "name": "Creator Profile",
      "item": [
        {
          "name": "Public Creator Profile",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": "{{baseUrl}}/api/profiles/{{influencerProfileId}}"
          }
        },
        {
          "name": "Patch My Profile (cover)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"profileImageUrl\": \"https://viralflight.cloud/uploads/profile-images/avatar.jpg\",\n  \"coverImageUrl\": \"https://viralflight.cloud/uploads/profile-images/cover.jpg\"\n}"
            },
            "url": "{{baseUrl}}/api/profiles/me"
          }
        }
      ]
    },
    {
      "name": "Uploads",
      "item": [
        {
          "name": "Upload Image",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "file", "type": "file", "src": [] }
              ]
            },
            "url": "{{baseUrl}}/api/uploads"
          }
        }
      ]
    },
    {
      "name": "Notifications",
      "item": [
        {
          "name": "List Notifications",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": "{{baseUrl}}/api/notifications?page=1&limit=20"
          }
        },
        {
          "name": "Mark Read",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": "{{baseUrl}}/api/notifications/{{notificationId}}/read"
          }
        },
        {
          "name": "Mark All Read",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": "{{baseUrl}}/api/notifications/read-all"
          }
        }
      ]
    }
  ]
}
