              ]
            }
          }
        },
        {
          "name": "Get Stats",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/influencer/youtube/stats"
          }
        },
        {
          "name": "Sync",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
