PORT=5000
MONGO_URI=mongodb+srv://USERNAME:PASSWORD@HOST/DATABASE

JWT_SECRET=change_this_access_token_secret
JWT_REFRESH_SECRET=change_this_refresh_token_secret
# Access and refresh JWTs do not expire. App logout clears the saved session.
PAYLOAD_SECRET=change_this_payload_admin_secret

# Viral Flight company CRM AI agent (OpenAI)
# Optional fallback — preferred: save key in portal Settings (/settings)
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx
ANTHROPIC_MODEL=claude-sonnet-4-5
PUBLIC_APP_URL=https://viralflight.cloud

TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_VERIFY_SERVICE_SID=VAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

INSTAGRAM_APP_ID=1234567890
INSTAGRAM_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
INSTAGRAM_REDIRECT_URI=http://localhost:5000/api/influencer/instagram/callback
INSTAGRAM_GRAPH_API_VERSION=v23.0
INSTAGRAM_TOKEN_ENCRYPTION_KEY=64_hex_character_key_for_aes_256_gcm_tokens

# YouTube OAuth (Google Cloud web application client)
YOUTUBE_CLIENT_ID=your_google_web_client_id
YOUTUBE_CLIENT_SECRET=your_google_web_client_secret
YOUTUBE_REDIRECT_URI=https://viralflight.cloud/api/v1/influencer/youtube/callback
# Optional app/web return URLs. When omitted, the callback returns JSON and
# the mobile app verifies the connection when it resumes.
YOUTUBE_OAUTH_SUCCESS_REDIRECT=
YOUTUBE_OAUTH_ERROR_REDIRECT=
# Optional; falls back to META_TOKEN_ENCRYPTION_KEY, JWT_SECRET, or PAYLOAD_SECRET.
YOUTUBE_TOKEN_ENCRYPTION_KEY=64_hex_character_key_for_aes_256_gcm_tokens
INSTAGRAM_OAUTH_SUCCESS_REDIRECT=http://localhost:3000/dashboard/influencer
INSTAGRAM_OAUTH_ERROR_REDIRECT=http://localhost:3000/dashboard/influencer
INSTAGRAM_RECENT_MEDIA_LIMIT=12

# Firebase Cloud Messaging (FCM)
FIREBASE_PROJECT_ID=altrixs-31959
FIREBASE_SERVICE_ACCOUNT_PATH=src/config/altrixs-31959-firebase-adminsdk.json
# Or raw JSON string / base64:
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
