PORT=5000
MONGO_URI=mongodb+srv://USERNAME:PASSWORD@HOST/DATABASE

JWT_SECRET=change_this_access_token_secret
JWT_REFRESH_SECRET=change_this_refresh_token_secret
# Access/refresh JWTs do not expire. Users stay logged in until they tap Logout.
PAYLOAD_SECRET=change_this_payload_admin_secret

# Viral Flight company CRM AI agent (OpenAI)
# Optional fallback — preferred: save key in portal Settings (/settings)
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx
ANTHROPIC_MODEL=claude-sonnet-4-5
PUBLIC_APP_URL=https://viralflight.cloud

# Twilio OTP (disabled — login uses LocalOtpService)
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_VERIFY_SERVICE_SID=VAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# OTP_EXPIRY_MS=600000

INSTAGRAM_APP_ID=1234567890
INSTAGRAM_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
INSTAGRAM_REDIRECT_URI=http://localhost:5000/api/influencer/instagram/callback
INSTAGRAM_GRAPH_API_VERSION=v23.0
INSTAGRAM_TOKEN_ENCRYPTION_KEY=64_hex_character_key_for_aes_256_gcm_tokens
INSTAGRAM_OAUTH_SUCCESS_REDIRECT=http://localhost:3000/dashboard/influencer
INSTAGRAM_OAUTH_ERROR_REDIRECT=http://localhost:3000/dashboard/influencer
INSTAGRAM_RECENT_MEDIA_LIMIT=12

# Meta Graph API (Instagram + Facebook OAuth) — preferred env names
META_APP_ID=1234567890
META_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
META_REDIRECT_URI_INSTAGRAM=https://viralflight.cloud/api/influencer/instagram/callback
META_REDIRECT_URI_FACEBOOK=https://viralflight.cloud/api/influencer/facebook/callback
META_GRAPH_API_VERSION=v21.0
META_TOKEN_ENCRYPTION_KEY=64_hex_character_key_for_aes_256_gcm_tokens
FACEBOOK_REDIRECT_URI=http://localhost:5000/api/influencer/facebook/callback

# Nightly social stats sync (set to false to disable)
SOCIAL_SYNC_CRON_ENABLED=true
SOCIAL_SYNC_INTERVAL_MS=86400000

# YouTube Data API v3 (Google OAuth)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=https://viralflight.cloud/api/influencer/youtube/callback
